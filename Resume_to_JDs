    print(f"\nResume: {fname}\n" + "-"*34)
    for r in results:
        print(f"vs JD ({r['JD_File']}) → Overall Score: {round(r['overall_score'],4)}")
    print("-"*34)
    return results

# --------------------
# BATCH order: embed all newly uploaded resumes first (so JDs compare to them in same run), then embed JDs and compare
# --------------------
def process_uploaded_jds_and_resumes(new_jd_files:list, new_resume_files:list):
    # First ensure resume embeddings are created (so JD comparisons can include these)
    for res in new_resume_files:
        # save & embed (caching prevents re-embedding existing)
        text = extract_text_from_pdf(str(res))
        sections = parse_resume(text)
        save_section_embeddings(RESUME_VECTORS, res.name, sections, {"filename": res.name, "sections": list(sections.keys())})
    # Now process JDs (each JD will compare vs all resumes including those just saved)
    for jd in new_jd_files:
        process_new_jd(str(jd), TOP_N)
    # Finally process resumes (compare each resume vs all stored JDs)
    for res in new_resume_files:
        process_new_resume(str(res), TOP_N)

