    "Responsibilities": 0.30
}

# --------------------
# UTILITIES: text extraction, cleaning, parsing
# --------------------
def clean_text(text: str) -> str:
    if not text:
        return ""
    text = re.sub(r'Page\s*\d+\s*(of\s*\d+)?', ' ', text, flags=re.I)
    text = re.sub(r'http\S+', ' ', text)
    text = re.sub(r'[\r\t]', ' ', text)
    text = re.sub(r'\s+', ' ', text)
    text = re.sub(r'[^\x00-\x7F]+',' ', text)
    return text.strip()

def extract_text_from_pdf(path: str) -> str:
    text = ""
    try:
        with pdfplumber.open(path) as pdf:
            for page in pdf.pages:
                t = page.extract_text()
                if t:
                    text += t + "\n"
    except Exception as e:
        # OCR fallback
        try:
            pages = convert_from_path(path)
            for page in pages:
                text += pytesseract.image_to_string(page) + "\n"
        except Exception as e2:
            print("PDF extraction error:", e, "| OCR fallback error:", e2)
    return clean_text(text)

def extract_section(text: str, start_pattern: str, end_pattern: str) -> str:
    try:
        m = re.search(rf"({start_pattern})(.+?)(?={end_pattern})", text, re.S | re.I)
        return m.group(2).strip() if m else ""
    except Exception:
        return ""

def parse_jd(text: str):
    return {
        "Required Skills": extract_section(text, r"Requirements|Required Skills|Technical Skills", r"Good to have|Preferred|Responsibilities|$"),
        "Good to Have": extract_section(text, r"Good to have|Preferred", r"Responsibilities|$"),
        "Responsibilities": extract_section(text, r"Responsibilities|Key Responsibilities", r"Requirements|Skills|$"),
    }

def parse_resume(text: str):
    return {
        "Skills": extract_section(text, r"Skills|Technical Skills|Technologies", r"Experience|Projects|Education|$"),
        "Experience": extract_section(text, r"Experience|Work History", r"Projects|Education|$"),
        "Projects": extract_section(text, r"Projects|Academic Projects", r"Experience|Education|$"),
    }

# --------------------
# EMBEDDING wrapper (OpenAI or local)
# --------------------
def embed_text_list(texts):
    """Return numpy array (N x EMB_DIM) for a list of texts."""
    if not texts:
        return np.zeros((0, EMB_DIM), dtype=np.float32)
    if USE_OPENAI:
        # chunking handled externally; OpenAI supports batch, but use per-call to catch errors
        out = []
        for t in texts:
            if not t or not t.strip():
                out.append(np.zeros(EMB_DIM, dtype=np.float32))
                continue
            try:
                resp = OPENAI_CLIENT.embeddings.create(model="text-embedding-3-small", input=t[:6000])
                vec = np.array(resp.data[0].embedding, dtype=np.float32)
                out.append(vec)
            except Exception as e:
                print("Embedding error:", e)
                out.append(np.zeros(EMB_DIM, dtype=np.float32))
        return np.vstack(out).astype(np.float32)
    else:
        emb = LOCAL_MODEL.encode(texts, batch_size=32, convert_to_numpy=True, show_progress_bar=False)
        return emb.astype(np.float32)

def embed_text_single(text):
    return embed_text_list([text])[0]

# --------------------
# CACHE: save/load per-file section-wise embeddings (no re-embed)
# --------------------
def save_section_embeddings(folder: Path, file_id: str, sections: dict, meta: dict):
    dest = folder / file_id
    dest.mkdir(parents=True, exist_ok=True)
    # compute embeddings in batch for sections that don't exist
    pending = []
    pending_keys = []
    for sec, txt in sections.items():
        sec_fname = dest / f"{sec.replace(' ','_')}.npy"
        if sec_fname.exists():
            continue
        pending.append(txt or "")
        pending_keys.append(sec)
    if pending:
        embs = embed_text_list(pending)
        for k, emb in zip(pending_keys, embs):
            np.save(dest / f"{k.replace(' ','_')}.npy", emb)
    # Ensure zero-vector saved for missing sections if not present
    for sec in sections.keys():
        sec_fname = dest / f"{sec.replace(' ','_')}.npy"
        if not sec_fname.exists():
            np.save(sec_fname, np.zeros(EMB_DIM, dtype=np.float32))
    # save meta
    (dest / "meta.json").write_text(json.dumps(meta, indent=2))

def load_all_section_embeddings(folder: Path):
    entries = []
    if not folder.exists():
        return entries
    for file_dir in sorted(folder.iterdir()):
        if not file_dir.is_dir():
            continue
        meta_path = file_dir / "meta.json"
        meta = json.loads(meta_path.read_text()) if meta_path.exists() else {}
        sec_vectors = {}
        for npy in file_dir.glob("*.npy"):
            sec_name = npy.stem  # section filename without .npy
            vec = np.load(npy)
            sec_vectors[sec_name.replace("_"," ")] = vec
        entries.append((file_dir.name, sec_vectors, meta))
    return entries

# --------------------
# SCORING helpers
# --------------------
def safe_cosine(v1: np.ndarray, v2: np.ndarray) -> float:
    if v1 is None or v2 is None:
        return 0.0
    if np.linalg.norm(v1)==0 or np.linalg.norm(v2)==0:
        return 0.0
    return float(cosine_similarity(v1.reshape(1,-1), v2.reshape(1,-1))[0][0])

def detailed_score_for_pair(jd_sec_vecs: dict, resume_sec_vecs: dict):
    section_scores = {}
    for jd_sec, mapped_res in SECTION_MAP.items():
        jvec = jd_sec_vecs.get(jd_sec)
        if jvec is None or np.linalg.norm(jvec)==0:
            section_scores[jd_sec] = 0.0
            continue
        subs = []
        for rsec in mapped_res:
            rvec = resume_sec_vecs.get(rsec)
            if rvec is not None:
                s = safe_cosine(jvec, rvec)
                subs.append(s)
        section_scores[jd_sec] = float(np.mean(subs)) if subs else 0.0
    total_weight = 0.0
    weighted_sum = 0.0
    for sec, score in section_scores.items():
        w = SECTION_WEIGHTS.get(sec, 1.0)
        weighted_sum += w * score
        total_weight += w
    overall = float(weighted_sum / total_weight) if total_weight>0 else 0.0
    return section_scores, overall

# --------------------
# PROCESS NEW JD & RESUME (incremental)
# --------------------
def process_new_jd(pdf_path: str, top_n: int = TOP_N):
    fname = Path(pdf_path).name
    file_id = fname
    print(f"\nProcessing JD: {fname}")
    text = extract_text_from_pdf(pdf_path)
    sections = parse_jd(text)
    save_section_embeddings(JD_VECTORS, file_id, sections, {"filename": fname, "sections": list(sections.keys())})

    resumes = load_all_section_embeddings(RESUME_VECTORS)
    if not resumes:
        print("No resumes stored yet — stored JD only.")
        return []

    jd_sec_vecs = {}
    jd_folder = JD_VECTORS / file_id
    for sec in sections.keys():
        p = jd_folder / f"{sec.replace(' ','_')}.npy"
        if p.exists():
            jd_sec_vecs[sec] = np.load(p)

    results = []
    for rid, rsecs, rmeta in resumes:
        sec_scores, overall = detailed_score_for_pair(jd_sec_vecs, rsecs)
        results.append({
            "JD_File": fname,
            "Resume_File": rmeta.get("filename", rid),
            "JD_ID": file_id,
            "Resume_ID": rid,
            "section_scores": sec_scores,
            "overall_score": overall
        })
    results = sorted(results, key=lambda x: x["overall_score"], reverse=True)[:top_n]

    out_rows = []
    for r in results:
        row = {
            "JD_File": r["JD_File"],
            "Resume_File": r["Resume_File"],
            "overall_score": round(r["overall_score"], 4)
        }
        for sec, val in r["section_scores"].items():
            row[f"{sec} ↔ ({' + '.join(SECTION_MAP[sec])})"] = round(val,4)
        out_rows.append(row)
    if out_rows:
        df = pd.DataFrame(out_rows)
        out_name = OUTPUT / f"jd_matches__{file_id}.csv"
        df.to_csv(out_name, index=False)
        print(f"Saved top matches → {out_name}")

    # Print in requested human-friendly format
    print(f"\nJD: {fname}\n" + "-"*34)
    for r in results:
        print(f"vs Resume ({r['Resume_File']}) → Overall Score: {round(r['overall_score'],4)}")
    print("-"*34)
    return results

def process_new_resume(pdf_path: str, top_n: int = TOP_N):
    fname = Path(pdf_path).name
    file_id = fname
    print(f"\nProcessing Resume: {fname}")
    text = extract_text_from_pdf(pdf_path)
    sections = parse_resume(text)
    save_section_embeddings(RESUME_VECTORS, file_id, sections, {"filename": fname, "sections": list(sections.keys())})

    jds = load_all_section_embeddings(JD_VECTORS)
    if not jds:
        print("No JDs stored yet — stored resume only.")
        return []

    resume_sec_vecs = {}
    resume_folder = RESUME_VECTORS / file_id
    for sec in sections.keys():
        p = resume_folder / f"{sec.replace(' ','_')}.npy"
        if p.exists():
            resume_sec_vecs[sec] = np.load(p)

    results = []
    for jid, jdsecs, jdmeta in jds:
        sec_scores, overall = detailed_score_for_pair(jdsecs, resume_sec_vecs)
        results.append({
            "Resume_File": fname,
            "JD_File": jdmeta.get("filename", jid),
            "Resume_ID": file_id,
            "JD_ID": jid,
            "section_scores": sec_scores,
            "overall_score": overall
        })
    results = sorted(results, key=lambda x: x["overall_score"], reverse=True)[:top_n]

    out_rows = []
    for r in results:
        row = {
            "Resume_File": r["Resume_File"],
            "JD_File": r["JD_File"],
            "overall_score": round(r["overall_score"], 4)
        }
        for sec, val in r["section_scores"].items():
            row[f"{sec} ↔ ({' + '.join(SECTION_MAP[sec])})"] = round(val, 4)
        out_rows.append(row)
    if out_rows:
        df = pd.DataFrame(out_rows)
        out_name = OUTPUT / f"resume_matches__{file_id}.csv"
